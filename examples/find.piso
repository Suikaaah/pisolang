type nat       = Z (* 0 *) | S (* n *) of nat
type 'a list   = Nil (* [] *) | Cons (* :: *) of 'a * 'a list
type bool      = False | True
type 'a signed = Neg of 'a | Pos of 'a
;;

iso rec map f = case
| []      <-> []
| x :: xs <-> f x :: map f xs
in

iso rec or = case
| []          <-> (False, [])
| Pos x :: xs <-> (True, Pos x :: xs)
| Neg x :: xs <-> let (b, xs) = or xs in (b, Neg x :: xs)
in

iso find f (xs) =
  let xs = map f xs in
  let (b, xs) = or xs in
  (b, map (inv f) xs)
in

iso finder = case
| 0       <-> Neg 0
| 1       <-> Pos 1
| S (S n) <-> Neg (S (S n))
in

find finder [3; 9; 0; 1; 5; 4; 4]

