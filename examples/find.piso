type nat     = Z (* 0 *) | S (* n *) of nat
type 'a list = Nil (* [] *) | Cons (* :: *) of 'a * 'a list
type bool    = False | True
;;

iso id (x) = x in

iso rec map f = case
| []      <-> []
| x :: xs <-> f x :: map f xs
in

iso rec or = case
| []               <-> (False, [])
| (True, x)  :: xs <-> (True, (True, x) :: xs)
| (False, x) :: xs <-> let (b, xs) = or xs in (b, (False, x) :: xs)
in

iso find f = (id * map (inv f)) . or . map f in

iso is_one = case
| 0       <-> (False, 0)
| 1       <-> (True, 1)
| S (S n) <-> (False, S (S n))
in

find is_one [3; 9; 0; 1; 5; 4; 4]

