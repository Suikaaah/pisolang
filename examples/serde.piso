iso rec serialize_list f = case
| []      <-> "N"
| x :: xs <->
  let (serialized, pos) = concat (f x, serialize_list f xs) in
  'C' :: serialize_nat pos :: serialized
in

*)

iso serialize_option f = case
| None   <-> "None"
| Some x <-> 'S' :: 'o' :: 'm' :: 'e' :: ' ' :: f x
in

iso deserialize = serialize_option (serialize_option serialize_bool) |> inv in

deserialize "Some Some False"

