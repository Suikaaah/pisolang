type bool      = False | True
type nat       = Z | S of nat
type 'a list   = Nil | Cons of 'a * 'a list
type 'a option = None | Some of 'a
;;

(* auxiliary functions *)

iso rec len = case
| []      <-> (0, [])
| x :: xs <-> let (n, xs) = len xs in (S n, x :: xs)
in

iso rec rev_aux = case
| (l, (0, []))        <-> (l, (0, []))
| (l, (S n, x :: xs)) <->
  let (l, (n, xs)) = rev_aux (x :: l, (n, xs)) in
  (l, (S n, xs))
in iso rev (l) =
  let (l, (n, [])) = rev_aux ([], len l) in
  inv len (n, l)
in

iso rec partition_aux = case
| (l, r, 0)         <-> (l, r, 0)
| (l, x :: xs, S n) <->
  let (l, xs, n) = partition_aux (x :: l, xs, n) in
  (l, xs, S n)
in iso partition (n, r) =
  let (l, r, n) = partition_aux ([], r, n) in
  (inv len (n, l) |> rev, r)
in

iso is_semicolon = case
| 'a' <-> (False, 'a') | 'b' <-> (False, 'b') | 'c' <-> (False, 'c')
| 'd' <-> (False, 'd') | 'e' <-> (False, 'e') | 'f' <-> (False, 'f')
| 'g' <-> (False, 'g') | 'h' <-> (False, 'h') | 'i' <-> (False, 'i')
| 'j' <-> (False, 'j') | 'k' <-> (False, 'k') | 'l' <-> (False, 'l')
| 'm' <-> (False, 'm') | 'n' <-> (False, 'n') | 'o' <-> (False, 'o')
| 'p' <-> (False, 'p') | 'q' <-> (False, 'q') | 'r' <-> (False, 'r')
| 's' <-> (False, 's') | 't' <-> (False, 't') | 'u' <-> (False, 'u')
| 'v' <-> (False, 'v') | 'w' <-> (False, 'w') | 'x' <-> (False, 'x')
| 'y' <-> (False, 'y') | 'z' <-> (False, 'z') | ';' <-> (True, ';')
in

iso rec find_semicolon = case
| []      <-> (0, [])
| x :: xs <->
  let (n, x :: xs) = match (is_semicolon x, xs) with
    | ((False, x), xs) <->
      let (n, xs) = find_semicolon xs in
      (S n, x :: xs)
    | ((True, ';'), xs) <-> (0, xs)
  in (n, x :: xs)
in

(* parsers *)

iso parse_bool = case
| ""  <-> False
| "a" <-> True
in

iso rec parse_nat = case
| ""        <-> 0
| 'a' :: xs <-> S (parse_nat xs)
in

iso rec parse_list f = case
| ""        <-> []
| 'a' :: xs <->
  let (l, r) = find_semicolon xs |> partition in
  f l :: parse_list f r
in

iso parse_option f = case
| ""        <-> None
| 'a' :: xs <-> Some (f xs)
in

(* serializer (inverted parser) *)

iso serialize = parse_list (parse_option parse_nat) |> inv in

serialize [Some 3; None; Some 4]

