type bool      = False | True
type nat       = Z | S of nat
type 'a list   = Nil | Cons of 'a * 'a list
type 'a option = None | Some of 'a
type symbol    = Normal of char | Open | Close | Delim
;;

(* auxiliary functions *)

iso rec len = case
| []      <-> (0, [])
| x :: xs <-> let (n, xs) = len xs in (S n, x :: xs)
in

iso rec map f = case
| []      <-> []
| x :: xs <-> f x :: map f xs
in

iso rec snoc_aux = case
| ([], y, 0) <-> ([y], 0)
| (x :: xs, y, S n) <->
  let (xs, n) = snoc_aux (xs, y, n) in
  (x :: xs, S n)
in iso snoc (xs, y) =
  let (n, xs) = len xs in
  let (xs, n) = snoc_aux (xs, y, n) in
  inv len (S n, xs)
in

iso rec rev_aux = case
| (l, (0, []))        <-> (l, (0, []))
| (l, (S n, x :: xs)) <->
  let (l, (n, xs)) = rev_aux (x :: l, (n, xs)) in
  (l, (S n, xs))
in iso rev (l) =
  let (l, (n, [])) = rev_aux ([], len l) in
  inv len (n, l)
in

iso symbol_of_char = case
| 'a' <-> Normal 'a'
| 'b' <-> Normal 'b'
| 'c' <-> Normal 'c'
| '(' <-> Open
| ')' <-> Close
| ' ' <-> Delim
in

iso rec find_delim = case
| ([]     , 0) <-> ([], 0, 0)
| (x :: xs, level) <->
  let (x :: xs, level, pos) = match (x, xs, level) with
    | (Normal x, xs, level) <->
      let (xs, level, pos) = find_delim (xs, level) in
      (Normal x :: xs, level, S pos)
    | (Open, xs, level) <->
      let (xs, level, pos) = find_delim (xs, S level) in
      (Open :: xs, level, S pos)
    | (Close, xs, S level) <->
      let (xs, level, pos) = find_delim (xs, level) in
      (Close :: xs, level, S pos)
    | (Delim, xs, S level) <->
      let (xs, level, pos) = find_delim (xs, S level) in
      (Delim :: xs, level, S pos)
    | (Delim, xs, 0) <-> (Delim :: xs, 0, 0)
  in (x :: xs, level, pos)
in

iso rec concat_aux = case
| ([], ys)      <-> (ys, 0)
| (x :: xs, ys) <->
  let (xs, n) = concat_aux (xs, x :: ys) in
  (xs, S n)
in iso concat (xs, ys) =
  let (zs, n) = concat_aux (rev xs, ' ' :: ys) in
  let (zs, 0) = inv find_delim (map symbol_of_char zs, 0, n) in
  map (inv symbol_of_char) zs
in

iso serialize_unit () = "" in

iso serialize_bool = case
| False <-> ""
| True  <-> "a"
in

iso rec serialize_nat = case
| 0   <-> ""
| S n <-> 'a' :: serialize_nat n
in

iso rec serialize_list f = case
| []      <-> ""
| x :: xs <-> '(' :: snoc (concat (f x, serialize_list f xs), ')')
in

iso serialize_option f = case
| None   <-> ""
| Some x <-> 'a' :: f x
in

(* []       -> b *)
(* [()]     -> (a b)*)
(* [(); ()] -> (a (a b)) *)

iso serialize = serialize_list (serialize_option serialize_nat) in
iso deserialize = inv serialize in

(* serialize [None; Some 3; Some 2] *)

deserialize "(aa (aaa ( (a ))))"

